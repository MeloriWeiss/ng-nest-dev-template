{
  "defaultBase": "master",
  "namedInputs": {
    "sharedGlobals": [],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/**/*.spec.[jt]s",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": [
      {
        "inputs": ["default", "^production", "{workspaceRoot}/karma.conf.js"],
        "cache": true
      },
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ],
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "generators": {
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "prefix": "sl",
      "style": "scss",
      "skipTests": true
    },
    "@nx/angular:component": {
      "style": "scss",
      "skipTests": true,
      "standalone": true,
      "changeDetection": "OnPush"
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "apps/api/**/*",
        "apps/web/**/*",
        "libs/api/auth/**/*",
        "libs/api/database-main/**/*",
        "libs/api/shared/**/*",
        "libs/api/users/**/*",
        "libs/shared/shared/**/*",
        "libs/web/auth/**/*",
        "libs/web/common-ui/**/*",
        "libs/web/data-access/**/*",
        "libs/web/home/**/*",
        "libs/web/layout/**/*",
        "libs/web/profile/**/*",
        "libs/web/shared/**/*",
        "tools/eslint-rules/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "e2e"
      },
      "include": ["apps/api-e2e/**/*"]
    }
  ],
  "analytics": false,
  "neverConnectToCloud": true
}
